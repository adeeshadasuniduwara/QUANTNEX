QUANTNEX_ENV=development
QUANTNEX_SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///./quantnex.db
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
TWELVE_DATA_API_KEY=
FINNHUB_API_KEY=

# Optional local MT5 read-only XAUUSD candles and broker Depth of Market (disabled by default)
QUANTNEX_MT5_ENABLED=false
QUANTNEX_MT5_GOLD_SYMBOL=XAUUSD
# Optional explicit terminal executable path
# QUANTNEX_MT5_TERMINAL_PATH=C:\\Program Files\\MetaTrader 5\\terminal64.exe
